# Gemini translation. Set this before using Translate / Auto Dub.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local faster-whisper configuration.
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# Edge TTS Khmer voices. Override if your Edge TTS voice catalog differs.
EDGE_TTS_MALE_VOICE=km-KH-PisethNeural
EDGE_TTS_FEMALE_VOICE=km-KH-SreymomNeural

# Files are stored locally under .studio-data by default.
# STUDIO_DATA_DIR=/absolute/path/to/data
STUDIO_MAX_UPLOAD_BYTES=2147483648
